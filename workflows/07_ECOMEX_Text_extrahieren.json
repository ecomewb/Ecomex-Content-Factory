    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "d6ad3cc5-ad4f-573c-8f77-b15ccc0f7d9b",
              "name": "abschnitte",
              "value": "={{ (() => { const z = ($json.zeilen || []).filter(r => r && !r.error); const out = []; for (let i = 0; i < z.length; i += 25) { out.push({ fundstelle: 'Zeilen ' + (i + 2) + '–' + (Math.min(i + 25, z.length) + 1), text: z.slice(i, i + 25).map(r => Object.entries(r).filter(([k, v]) => v !== '' && v != null).map(([k, v]) => k + ': ' + v).join('; ')).join('\\n') }); } return out; })() }}",
              "type": "array"
            },
            {
              "id": "7eee9bb3-9f5f-53c9-b306-776cbd011fc6",
              "name": "extraktion",
              "value": "n8n",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "bc27060e-af30-5fac-9a76-a69d07cc0778",
      "name": "Edit Fields4",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        1340,
        580
      ],
      "notes": "Zeilen → Abschnitte",
      "notesInFlow": true
    },
    {
      "parameters": {
        "operation": "text",
        "binaryPropertyName": "datei",
        "destinationKey": "inhalt",
        "options": {}
      },
      "id": "69b06a3a-458d-51a2-814c-0d8903fdcd30",
      "name": "Extract from File3",
      "type": "n8n-nodes-base.extractFromFile",
      "typeVersion": 1,
      "position": [
        900,
        800
      ],
      "notes": "Text/Markdown",
      "notesInFlow": true,
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "27c40a29-6523-5c68-95ce-5211fb29acac",
              "name": "abschnitte",
              "value": "={{ (() => { const t = String($json.inhalt || ''); const teile = t.split(/\\n(?=#{1,3} )/); const out = []; let n = 0; teile.forEach(p => { for (let i = 0; i < p.length; i += 4000) { n += 1; const kopf = (p.match(/^#{1,3} (.+)/) || [])[1]; out.push({ fundstelle: kopf ? ('Abschnitt ' + n + ': ' + kopf.slice(0, 60)) : ('Abschnitt ' + n), text: p.slice(i, i + 4000) }); } }); return out; })() }}",
              "type": "array"
            },
            {
              "id": "7eee9bb3-9f5f-53c9-b306-776cbd011fc6",
              "name": "extraktion",
              "value": "n8n",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "35760cf2-485b-5fa9-a98c-0e38e9b98ebb",
      "name": "Edit Fields5",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        1120,
        800
      ],
      "notes": "Abschnitte bilden",
      "notesInFlow": true
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "0d870eb4-d6b2-5d32-94a2-154c25a4a235",
              "name": "abschnitte",
              "value": "={{ [] }}",
              "type": "array"
            },
            {
              "id": "9d4608b5-bd05-506a-9737-82b02fa6537d",
              "name": "hinweis",
              "value": "={{ 'Dateityp .' + $json.endung + ' kann ohne Renderer nicht gelesen werden. Bitte als PDF speichern und erneut hochladen.' }}",
              "type": "string"
            },
            {
              "id": "7eee9bb3-9f5f-53c9-b306-776cbd011fc6",
              "name": "extraktion",
