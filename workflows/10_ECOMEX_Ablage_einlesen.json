      "parameters": {
        "method": "POST",
        "url": "={{ $json.konfig.supabase_url }}/rest/v1/rpc/ecomex_storage_inventory",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "supabaseApi",
        "options": {
          "timeout": 60000
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ p_bucket: $json.konfig.supabase_bucket, p_prefix: $('Edit Fields').first().json.ordner_praefix || '' }) }}"
      },
      "id": "685ac998-fb7d-583e-ad87-a48d4c72612c",
      "name": "HTTP Request",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        680,
        220
      ],
      "notes": "Ablage-Inventar aus der Datenbank",
      "notesInFlow": true,
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "mode": "raw",
        "jsonOutput": "={{ (() => {\n  const s = $('Edit Fields').first().json;\n  const alle = $('HTTP Request').all().map(i => i.json).filter(o => o && o.object_path);\n  const max = Number(s.max_mb || 60) * 1048576;\n  const dateien = alle.filter(o => o.empfohlen && Number(o.bytes || 0) <= max);\n  const zu_gross = alle.filter(o => o.empfohlen && Number(o.bytes || 0) > max);\n  const nicht = alle.filter(o => !o.empfohlen);\n  return { dateien, zu_gross, nicht_eingelesen: nicht, gesamt: alle.length, probelauf: s.probelauf === true || s.probelauf === 'true' };\n})() }}",
        "options": {}
      },
